<body>
<div id="app">
    <header class="header-modern">
        <div class="header-content">
            <div class="header-top">
                <a href="/" class="logo-section">
                    <div class="hex-icon">
                        <img src="/static/static/logo.png" alt="DERO Project">
                    </div>
                    <div class="title-section">
                        <h1 class="explorer-title">DERO HE BlockChain Explorer
                        {{if .testnet}}
                        <span class="network-text">Testnet</span>
                        {{else}}
                        <span class="network-text">Mainnet</span>
                        {{end}}
                        </h1>
                    </div>
                </a>
                
                <div class="search-container">
                    <form action="/search" method="get" class="search-form">
                        <input type="text" name="value" class="search-input" 
                               placeholder="Search by block height, block hash, or transaction hash...">
                        <button type="submit" class="search-btn">Search</button>
                    </form>
                </div>
            </div>

            {{if .Network_Difficulty}}
            <div class="network-stats">
                <div class="stat-item">
                    <div class="stat-label">Network Difficulty</div>
                    <div class="stat-value">{{ .Network_Difficulty }}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Hash Rate</div>
                    <div class="stat-value">{{ .hash_rate }} MH/s</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Avg Block Time</div>
                    <div class="stat-value">{{.averageblocktime50}}s</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Total Supply</div>
                    <div class="stat-value">{{ .total_supply }}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Mempool</div>
                    <div class="stat-value"><a href="/txpool">{{ .txpool_size }} TXs</a></div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Fee per KB</div>
                    <div class="stat-value">{{.fee_per_kb}}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Block Size Limit</div>
                    <div class="stat-value">{{.median_block_size}} kB</div>
                </div>
            </div>
            {{end}}
        </div>
    </header>

    <main class="container">
{{end}}
