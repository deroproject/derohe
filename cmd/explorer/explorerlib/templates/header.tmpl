    <script>
function copyToClipboard(text, btn) {
    navigator.clipboard.writeText(text).then(function() {
        var original = btn.textContent;
        btn.textContent = '✓ Copied';
        btn.style.borderColor = '#4ade80';
        btn.style.color = '#4ade80';
        setTimeout(function() {
            btn.textContent = original;
            btn.style.borderColor = '';
            btn.style.color = '';
        }, 2000);
    }).catch(function(err) {
        console.error('Failed to copy:', err);
    });
}
function truncateHash(hash) {
    if (!hash) return '';
    var str = String(hash);
    // Only truncate if it's a 64-character hex hash
    if (str.length === 64 && /^[0-9a-fA-F]+$/.test(str)) {
        return str.substring(0, 8) + '...' + str.substring(str.length - 8);
    }
    return str;
}
function copyElementText(id, btn) {
    var el = document.getElementById(id);
    if (!el) return;
    copyToClipboard(el.textContent, btn);
}
function toggleCollapse(id, btn) {
    var el = document.getElementById(id);
    if (!el || !btn) return;
    if (el.style.display === 'none') {
        el.style.display = 'block';
        btn.textContent = btn.textContent.replace('Show', 'Hide');
    } else {
        el.style.display = 'none';
        btn.textContent = btn.textContent.replace('Hide', 'Show');
    }
}
document.addEventListener('DOMContentLoaded', function() {
    // Make table rows clickable
    document.querySelectorAll('.tx-table tbody tr').forEach(function(row) {
        row.addEventListener('click', function(e) {
            // Don't trigger if clicking a button or link
            if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A' || e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            var link = row.querySelector('a[href^="/block/"], a[href^="/tx/"]');
            if (link) {
                window.location.href = link.href;
            }
        });
    });
    
    // Make block rows clickable
    document.querySelectorAll('.block-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
            if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A' || e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            var link = row.querySelector('a[href^="/block/"]');
            if (link) {
                window.location.href = link.href;
            }
        });
    });
});
    </script>
